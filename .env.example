# Field Compliance — local / CI environment template
# Copy to .env.local for Next.js development. Never commit real secrets.

# Public Supabase project URL (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable (anon) key — NEVER use the service_role key here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_or_anon_key

# Optional alias used by some older Supabase projects. The app falls back to this
# if NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY is unset.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public site URL used for auth email redirects (sign-up confirmation, password reset)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Server-only. Used exclusively by local SQL/test harnesses — never import
# this into client components or NEXT_PUBLIC_* variables.
# SUPABASE_SERVICE_ROLE_KEY=
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
